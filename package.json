{
  "name": "fallback-dependencies",
  "description": "📦 Add git repo dependencies to your Node.js app from a cascading list of fallback locations.",
  "author": "Roosevelt Framework Team <rooseveltframework@gmail.com>",
  "contributors": [
    {
      "name": "Contributors",
      "url": "https://github.com/rooseveltframework/fallback-dependencies/graphs/contributors"
    }
