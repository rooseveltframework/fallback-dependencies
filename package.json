  "version": "2.0.2",
  "files": [
    "fallback-dependencies.js",
    "CHANGELOG.md",
    "CONFIGURATION.md",
    "README.md",
    "USAGE.md"
  ],
  "homepage": "https://rooseveltframework.org/docs/fallback-dependencies/latest",
  "license": "CC-BY-4.0",
  "main": "fallback-dependencies.js",
  "engines": {
    "node": ">=22.20.0"
  },
  "dependencies": {
    "npm-package-arg": "14.0.0",
    "pacote": "22.0.0",
    "roosevelt-logger": "2.0.0"
  },
  "devDependencies": {
    "standard": "17.1.2"
  },
  "scripts": {
    "coverage": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\" && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.js\"",
    "lint": "standard",
    "lint-fix": "standard --fix",
    "test": "node --test \"test/**/*.test.js\"",
    "test-debug": "node --inspect-brk --test \"test/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/rooseveltframework/fallback-dependencies.git"
  },
